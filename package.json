{
  "name": "agent-sql-firewall",
  "version": "0.1.0",
  "description": "AST-based SQL firewall middleware that blocks destructive queries from LLM agents before they reach Postgres.",
  "license": "MIT",
  "author": "shreeghadge1212-boop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shreeghadge1212-boop/agent-sql-firewall.git"
  },
  "homepage": "https://github.com/shreeghadge1212-boop/agent-sql-firewall#readme",
  "bugs": { "url": "https://github.com/shreeghadge1212-boop/agent-sql-firewall/issues" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:pg": "vitest run test/postgres-oracle.test.ts",
    "bench": "tsx bench/bench.ts",
    "mutate": "stryker run",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "dependencies": {
    "pgsql-ast-parser": "^12.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.43",
    "express": "^4.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "llm", "ai-agents", "agent", "sql", "postgres", "firewall", "security",
    "sql-injection", "ast", "express", "middleware", "langchain", "mcp"
  ]
}